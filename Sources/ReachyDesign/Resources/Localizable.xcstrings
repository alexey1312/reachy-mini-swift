    "An app installed on your Reachy Mini.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine auf deinem Reachy Mini installierte App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app instalada en tu Reachy Mini."
          }
        },
        "fr": {
