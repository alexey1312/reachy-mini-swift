            "state": "translated",
            "value": "Se perdió el robot al enviar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Robot perdu pendant l'envoi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Робот потерян во время отправки"
          }
        }
      }
    },
    "Lower means the head follows less of the way. The switch above is what stops it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedriger heißt, der Kopf folgt weniger weit. Ganz aufhören lässt ihn der Schalter darüber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más bajo significa que la cabeza sigue menos. El interruptor de arriba es lo que lo detiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus bas, la tête suit moins loin. C'est l'interrupteur au-dessus qui l'arrête."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем ниже, тем меньше голова доводит движение. Полностью останавливает переключатель выше."
          }
        }
      }
    },
    "Maintenance": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenimiento"
          }
        },
        "fr": {
