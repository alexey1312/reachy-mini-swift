    "Speak to Reachy, or type below. Anything said before this opened was not recorded — the robot keeps no transcript.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich mit Reachy oder tippe unten. Alles, was vor dem Öffnen gesagt wurde, ist nicht aufgezeichnet — der Roboter führt kein Protokoll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con Reachy o escribe abajo. Nada de lo dicho antes de abrir esto quedó registrado: el robot no guarda transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez à Reachy, ou écrivez ci-dessous. Rien de ce qui a été dit avant l'ouverture n'a été enregistré — le robot ne conserve aucune transcription."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите с Reachy или наберите текст ниже. Всё сказанное до открытия не записано — робот не хранит расшифровок."
          }
        }
      }
    },
