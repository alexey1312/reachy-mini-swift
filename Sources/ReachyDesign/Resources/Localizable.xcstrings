    "Forgetting the network the robot is on takes it off this network at the next restart. The robot's own hotspot cannot be forgotten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird das Netzwerk entfernt, in dem der Roboter gerade ist, verlässt er es beim nächsten Neustart. Der eigene Hotspot des Roboters lässt sich nicht entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si olvidas la red en la que está el robot, la abandonará en el próximo reinicio. El punto de acceso propio del robot no se puede olvidar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier le réseau sur lequel se trouve le robot l'en fait sortir au prochain redémarrage. Le point d'accès propre du robot ne peut pas être oublié."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если забыть сеть, в которой находится робот, при следующем перезапуске он её покинет. Собственную точку доступа робота забыть нельзя."
          }
        }
      }
    },
