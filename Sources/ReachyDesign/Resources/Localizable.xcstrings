    "This cannot be undone from here. Download a copy first if you might need it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich von hier aus nicht rückgängig machen. Lade vorher eine Kopie herunter, falls du sie brauchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer desde aquí. Descarga antes una copia si puede que la necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci ne peut pas être annulé d'ici. Téléchargez d'abord une copie si vous risquez d'en avoir besoin."
