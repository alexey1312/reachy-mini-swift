    "Finds your robot on this Wi-Fi and talks to it. Without it the robot cannot be reached at all.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet deinen Roboter in diesem Wi-Fi und kommuniziert mit ihm. Ohne diese Berechtigung ist der Roboter überhaupt nicht erreichbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tu robot en este Wi-Fi y se comunica con él. Sin este permiso, el robot no se puede alcanzar en absoluto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve votre robot sur ce Wi-Fi et communique avec lui. Sans cette autorisation, le robot est totalement injoignable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит вашего робота в этой сети Wi-Fi и общается с ним. Без этого робот вообще недоступен."
          }
        }
      }
    },
