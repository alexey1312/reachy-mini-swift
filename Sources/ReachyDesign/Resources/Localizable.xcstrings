    "Unlinking takes the robot off the relay: it goes offline and comes back only once somebody sets it up again in person.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Trennen nimmt den Roboter vom Relay: Er geht offline und kommt erst zurück, wenn ihn jemand vor Ort neu einrichtet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desvincularlo lo quita del relé: se desconecta y no vuelve hasta que alguien lo configure de nuevo en persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dissociation retire le robot du relais : il passe hors ligne et ne revient que lorsque quelqu'un le reconfigure sur place."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
