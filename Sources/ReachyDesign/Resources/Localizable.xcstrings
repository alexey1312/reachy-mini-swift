    "Reachy Mini was off. It's starting up and will wake itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachy Mini war aus. Er startet und weckt sich selbst auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachy Mini estaba apagado. Está arrancando y se despertará solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachy Mini était éteint. Il démarre et se réveillera de lui-même."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachy Mini был выключен. Он запускается и проснётся сам."
          }
        }
      }
    },
    "Reachy Mini was off. It's starting up — try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachy Mini war aus. Er startet — versuche es in einem Moment erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachy Mini estaba apagado. Está arrancando — inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachy Mini était éteint. Il démarre — réessayez dans un instant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachy Mini был выключен. Он запускается — попробуйте ещё раз через минуту."
          }
        }
      }
    },
    "Read from the robot every few seconds, while this screen is open.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird alle paar Sekunden vom Roboter gelesen, solange dieser Bildschirm offen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lee del robot cada pocos segundos mientras esta pantalla está abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu depuis le robot toutes les quelques secondes, tant que cet écran est ouvert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считывается с робота каждые несколько секунд, пока открыт этот экран."
          }
        }
      }
    },
    "Read when this screen opens, and again when you pull it down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Öffnen dieser Ansicht gelesen und erneut, wenn Sie sie nach unten ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lee al abrir esta pantalla y de nuevo cuando tira de ella hacia abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu à l'ouverture de cet écran, puis de nouveau lorsque vous le tirez vers le bas."
