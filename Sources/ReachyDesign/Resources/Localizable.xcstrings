    "Restarting the robot's software releases it: Settings › Advanced › Recovery over Bluetooth, then RESTART_DAEMON.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Neustart der Software des Roboters gibt sie frei: Einstellungen › Erweitert › Wiederherstellung über Bluetooth, dann RESTART_DAEMON."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar el software del robot la libera: Ajustes › Avanzado › Recuperación por Bluetooth y luego RESTART_DAEMON."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
