    "Bluetooth drops journal lines when the robot logs faster than this can read. Once the robot is on the network, the Diagnostics console is the complete one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth verwirft Journal-Zeilen, wenn der Roboter schneller protokolliert als hier gelesen werden kann. Sobald der Roboter im Netzwerk ist, ist die Diagnose-Konsole die vollständige."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth descarta líneas del journal cuando el robot registra más rápido de lo que se puede leer aquí. Cuando el robot esté en la red, la consola de Diagnóstico será la completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth perd des lignes de journal quand le robot en écrit plus vite qu'on ne peut les lire ici. Dès que le robot est sur le réseau, la console de Diagnostic est la complète."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth теряет строки журнала, когда робот пишет их быстрее, чем их удаётся прочитать. Как только робот появится в сети, полной будет консоль Диагностики."
          }
        }
      }
    },
    "Bluetooth is switched off": {
      "extractionState": "manual",
