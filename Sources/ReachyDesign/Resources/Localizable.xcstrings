          }
        }
      }
    },
    "Powering off needs the robot's own network.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Ausschalten wird das eigene Netzwerk des Roboters gebraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para apagarlo hace falta la propia red del robot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'extinction nécessite le réseau propre du robot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выключения нужна собственная сеть робота."
          }
        }
      }
    },
    "Powering off stops the camera, the motors and the state stream. Wake up brings it back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ausschalten stoppen Kamera, Motoren und Zustandsstream. Aufwecken bringt alles zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al apagarlo se detienen la cámara, los motores y el flujo de estado. Despertar lo restablece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'extinction arrête la caméra, les moteurs et le flux d'état. Réveiller les rétablit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При выключении останавливаются камера, моторы и поток состояния. Разбудить вернёт всё обратно."
          }
        }
      }
    },
    "Powering off… going to sleep first": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird ausgeschaltet… schläft zuerst ein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagando… primero se duerme"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extinction… mise en veille d'abord"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключаем… сначала засыпает"
          }
        }
      }
    },
    "Pre-release versions need daemon 1.10.0. An older robot finds the wrong version and refuses to install it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorabversionen benötigen Daemon 1.10.0. Ein älterer Roboter findet die falsche Version und installiert sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones preliminares necesitan el daemon 1.10.0. Un robot más antiguo encuentra la versión equivocada y no la instala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préversions nécessitent le démon 1.10.0. Un robot plus ancien trouve la mauvaise version et refuse de l'installer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительные версии требуют демона 1.10.0. Робот постарше находит не ту версию и отказывается её ставить."
