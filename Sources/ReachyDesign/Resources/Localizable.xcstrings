      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladene Modellgewichte werden gelöscht. Der Roboter lädt sie erneut herunter, wenn eine App sie braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan los pesos de modelo descargados. El robot los vuelve a descargar cuando una app los necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les poids de modèle téléchargés sont supprimés. Le robot les retélécharge lorsqu'une app en a besoin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженные веса моделей будут удалены. Робот скачает их снова, когда они понадобятся приложению."
          }
        }
      }
    },
    "Drag to look around. Hold at the side to turn the body.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, um dich umzusehen. Am Rand halten, um den Körper zu drehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mirar alrededor. Mantén en el borde para girar el cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour regarder autour. Maintenez sur le côté pour tourner le corps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяните, чтобы осмотреться. Удерживайте у края, чтобы повернуть корпус."
          }
        }
      }
