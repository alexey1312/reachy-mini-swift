    "Bluetooth's job is done. The app will pick the robot up on the network from here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth hat seine Arbeit getan. Ab hier findet die App den Roboter im Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ya ha cumplido su función. A partir de aquí, la app encontrará el robot en la red."
