    "It may have finished — check the installed list.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise ist sie fertig — sieh in der Liste der installierten Apps nach."
          }
        },
        "es": {
