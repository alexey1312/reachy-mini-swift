    "Robots all advertise the same name, so they are listed by signal strength.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Roboter melden sich mit demselben Namen, daher sind sie nach Signalstärke aufgelistet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los robots se anuncian con el mismo nombre, así que se listan por intensidad de señal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les robots se signalent sous le même nom : ils sont donc classés par puissance de signal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все роботы объявляют себя одним и тем же именем, поэтому они отсортированы по уровню сигнала."
          }
        }
      }
    },
    "Robots all advertise the same name, so they are listed by signal strength. The nearest one is at the top.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Roboter melden sich mit demselben Namen, daher sind sie nach Signalstärke aufgelistet. Der nächste steht oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los robots se anuncian con el mismo nombre, así que se listan por intensidad de señal. El más cercano está arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les robots se signalent sous le même nom : ils sont donc classés par puissance de signal. Le plus proche est en haut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все роботы объявляют себя одним и тем же именем, поэтому они отсортированы по уровню сигнала. Ближайший — сверху."
          }
        }
      }
    },
    "Robots linked to your Hugging Face account, wherever they are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Hugging Face-Konto verknüpfte Roboter, wo auch immer sie sind."
