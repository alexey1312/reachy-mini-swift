    "Sent again the instant before the command goes out, so a session opened earlier for something harmless cannot carry this through with it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird unmittelbar vor dem Absenden des Befehls erneut gesendet, damit eine früher für etwas Harmloses geöffnete Sitzung diesen Befehl nicht mit durchbringen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envía de nuevo justo antes de que salga el comando, para que una sesión abierta antes con un fin inocuo no pueda colar este comando con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyé juste avant l'émission de la commande, afin qu'une session ouverte plus tôt pour quelque chose d'anodin ne puisse pas faire passer celle-ci avec elle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляется повторно прямо перед выдачей команды, чтобы сеанс, открытый ранее для чего-то безобидного, не смог провести её вместе с собой."
          }
        }
      }
    },
