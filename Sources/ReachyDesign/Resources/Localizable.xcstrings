    "Allow Bluetooth for this app in Settings, then come back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Bluetooth für diese App in den Einstellungen und komm dann zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Bluetooth para esta app en Ajustes y vuelve aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Bluetooth pour cette app dans Réglages, puis revenez ici."
          }
        },
