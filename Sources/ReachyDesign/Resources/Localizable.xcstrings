            "value": "El robot aún no ha registrado un flujo de vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le robot n'a pas encore enregistré de flux vidéo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Робот пока не зарегистрировал видеопоток."
          }
        }
      }
    },
    "The robot has not sent any installer output yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Roboter hat noch keine Ausgabe des Installationsprogramms gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El robot aún no ha enviado ninguna salida del instalador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le robot n'a pas encore envoyé de sortie d'installation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Робот пока не отправил вывод установщика."
          }
        }
      }
    },
    "The robot has put its own reachy-mini-ap network back up, so nothing is lost — it is waiting to be told again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Roboter hat sein eigenes reachy-mini-ap-Netzwerk wieder aufgebaut, es ist also nichts verloren — er wartet darauf, es erneut gesagt zu bekommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El robot ha vuelto a levantar su propia red reachy-mini-ap, así que nada se ha perdido — está esperando que se le indique de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le robot a rétabli son propre réseau reachy-mini-ap : rien n'est perdu — il attend qu'on lui indique à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Робот снова поднял собственную сеть reachy-mini-ap, так что ничего не потеряно — он ждёт повторных указаний."
          }
        }
      }
    },
    "The robot heard a voice in front of it or behind it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Roboter hat eine Stimme vor oder hinter sich gehört"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El robot oyó una voz delante o detrás de él"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le robot a entendu une voix devant ou derrière lui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Робот услышал голос впереди или позади себя"
          }
        }
      }
    },
    "The robot heard a voice on its left": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Roboter hat eine Stimme links von sich gehört"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El robot oyó una voz a su izquierda"
          }
        },
        "fr": {
