            "state": "translated",
            "value": "Une app installée sur votre Reachy Mini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение, установленное на вашем Reachy Mini."
          }
        }
      }
    },
    "Announced while the app is still running in the background, not after it has been closed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gemeldet, solange die App noch im Hintergrund läuft — nicht mehr, nachdem sie geschlossen wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se avisa mientras la app sigue en segundo plano, no después de cerrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annoncé tant que l'app tourne encore en arrière-plan, pas une fois qu'elle est fermée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщим, пока приложение ещё работает в фоне, — но не после того, как оно закрыто."
          }
        }
      }
    },
    "Antennas": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
