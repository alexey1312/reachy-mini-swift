    "Erases the robot's Python environments and restores the factory copy. Every installed app and everything it stored is gone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Python-Umgebungen des Roboters und stellt die Werkskopie wieder her. Jede installierte App und alles, was sie gespeichert hat, ist weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra los entornos de Python del robot y restaura la copia de fábrica. Todas las apps instaladas y todo lo que guardaron desaparecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les environnements Python du robot et restaure la copie d'usine. Toutes les apps installées et tout ce qu'elles ont stocké disparaissent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирает Python-окружения робота и восстанавливает заводскую копию. Все установленные приложения и всё, что они сохранили, исчезают."
          }
        }
      }
    },
