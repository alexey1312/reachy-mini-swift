    "First time connecting to this robot over SSH. To be certain, compare the key with ssh-keygen -lf on the robot.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste Verbindung zu diesem Roboter über SSH. Vergleiche den Schlüssel zur Sicherheit mit ssh-keygen -lf auf dem Roboter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la primera conexión a este robot por SSH. Para estar seguro, compara la clave con ssh-keygen -lf en el robot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première connexion à ce robot via SSH. Pour en être sûr, comparez la clé avec ssh-keygen -lf sur le robot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это первое подключение к этому роботу по SSH. Чтобы убедиться, сравните ключ с выводом ssh-keygen -lf на роботе."
          }
        }
      }
    },
