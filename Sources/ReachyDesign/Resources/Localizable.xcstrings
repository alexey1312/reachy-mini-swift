    "Linking copies your token to the robot over the local network, which is not encrypted. Do it on a network you trust.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Verknüpfen wird dein Token über das lokale Netzwerk auf den Roboter kopiert, unverschlüsselt. Mache das in einem Netzwerk, dem du vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al vincular se copia tu token al robot por la red local, que no está cifrada. Hazlo en una red de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'association copie votre jeton vers le robot via le réseau local, sans chiffrement. Faites-le sur un réseau de confiance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При привязке ваш токен копируется на робота по локальной сети без шифрования. Делайте это в сети, которой доверяете."
          }
        }
      }
    },
