        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обслуживание"
          }
        }
      }
    },
    "Measured by the robot's software once a second. The rate is what the motors are actually driven at.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Software des Roboters einmal pro Sekunde gemessen. Die Rate ist die, mit der die Motoren tatsächlich angesteuert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido por el software del robot una vez por segundo. La frecuencia es a la que realmente se mueven los motores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré par le logiciel du robot une fois par seconde. La cadence est celle à laquelle les moteurs sont réellement pilotés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряется ПО робота раз в секунду. Это частота, с которой на самом деле управляются моторы."
          }
        }
      }
    },
