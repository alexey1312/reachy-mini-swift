    "Summarized on this device and never sent anywhere. It can be wrong — the log is the record.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät zusammengefasst und nirgendwohin gesendet. Es kann falsch sein — maßgeblich ist das Protokoll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumido en este dispositivo y nunca enviado a ninguna parte. Puede equivocarse: el registro es lo que cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumé sur cet appareil et jamais envoyé nulle part. Cela peut être faux — le journal fait foi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обобщено на этом устройстве и никуда не отправлялось. Может быть неверным — источник истины это сам лог."
          }
        }
      }
    },
