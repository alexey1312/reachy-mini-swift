    },
    "Tells you when an install or a robot update finishes while you're in another app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet dir, wenn eine Installation oder ein Roboter-Update fertig wird, während du in einer anderen App bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa cuando termina una instalación o una actualización del robot mientras estás en otra app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous prévient quand une installation ou une mise à jour du robot se termine pendant que vous êtes dans une autre app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает, что установка или обновление робота завершились, пока вы в другом приложении."
          }
        }
      }
    },
    "Temperature": {
