amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Builtins.pkl"

// =============================================================================
// hk Configuration for ReachyMini
// =============================================================================
// Hooks run in parallel except where a step declares `depends`. The Swift steps
// are chained deliberately: swiftformat rewrites the very files swiftlint fixes,
// and a --strict check ahead of the formatter flags wrapping the formatter was
// about to correct. Timed runs show hk serialising them either way — both claim
// `stage = *.swift` — so this pins the order rather than leaving it to that.
// Note `depends` orders steps; it does not skip a step whose dependency failed.
// Keep the hk@X.Y.Z package URI above in lockstep with the hk version pinned in
// mise.toml.
// =============================================================================

local generated_excludes = List(".build/**", "Sources/ReachyKit/Generated/**", "CHANGELOG.md")

local swift_linters = new Mapping<String, Step> {
    ["swiftformat"] {
        glob = List("*.swift")
        check = "swiftformat --lint {{files}}"
        fix = "swiftformat {{files}}"
        batch = true
        stage = List("*.swift")
        check_first = true
        hide = true
    }
    ["swiftlint"] {
        glob = List("*.swift")
        fix = "swiftlint --fix {{files}}"
        batch = true
        stage = List("*.swift")
        depends = "swiftformat"
        hide = true
    }
    // Strict check after fix to catch unfixable errors
    ["swiftlint-strict"] {
        glob = List("*.swift")
        check = "swiftlint lint --strict --quiet {{files}}"
        batch = true
        depends = "swiftlint"
        hide = true
    }
}

local dprint_checks = new Mapping<String, Step> {
    ["dprint"] = (Builtins.dprint) {
        exclude = List("CHANGELOG.md", ".claude/**", ".github/ISSUE_TEMPLATE/**")
        stage = List("*.md")
        check_first = true
        hide = true
    }
}

local builtin_checks = new Mapping<String, Step> {
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
        exclude = generated_excludes
        hide = true
    }
    ["check-merge-conflict"] = (Builtins.check_merge_conflict) {
        hide = true
    }
    ["newlines"] = (Builtins.newlines) {
        exclude = generated_excludes
        hide = true
    }
    ["actionlint"] {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
        check = "actionlint {{files}}"
        batch = true
        hide = true
    }
}

// Rule 9's other half: the key a `.reachy(_:)` names has to be *in* the catalogue.
// A missing one renders the English key perfectly and for ever, so 139 of them
// accumulated unnoticed — this is the step that makes that a commit-time failure
// rather than something CI mentions later.
local catalogue_checks = new Mapping<String, Step> {
    ["catalogue"] {
        // Both extensions matter: the drift opens by editing Swift *or* the catalogue.
        glob = List("*.swift", "*.xcstrings")
        // Deliberately no `{{files}}`. The script compares the whole tree against the
        // whole catalogue; handed a subset of the staged files it would report every
        // key the unstaged ones use as missing. `batch = false` keeps that one
        // invocation rather than one per group of the files that triggered it.
        check = "python3 Scripts/check-catalogue.py"
        batch = false
        // swiftformat and `swiftlint --fix` rewrite the very files this reads, and a
        // reader racing them sees half-written source — the same reason the Swift
        // steps above are chained. Ordering only; a failed swiftlint does not skip it.
        depends = "swiftlint"
        hide = true
    }
}

local all_linters = new Mapping<String, Step> {
    ...swift_linters
    ...dprint_checks
    ...builtin_checks
    ...catalogue_checks
}

hooks {
    // Pre-commit: runs all linters with auto-fix
    ["pre-commit"] {
        fix = true
        stash = "none"
        steps = all_linters
    }

    // Commit-msg: validate conventional commits format
    ["commit-msg"] {
        steps {
            ["conventional-commit"] = Builtins.check_conventional_commit
        }
    }

    // Helper: run all linters with fix
    ["fix"] {
        fix = true
        steps = all_linters
    }

    // Helper: run all linters without fix
    ["check"] {
        steps = all_linters
    }
}
