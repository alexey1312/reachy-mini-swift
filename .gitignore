# Swift / SPM
.build/
.swiftpm/
Package.resolved.orig

# Xcode / Tuist
*.xcodeproj
*.xcworkspace
Apps/Derived/
DerivedData/
xcuserdata/

# Regenerated by `mise run storybook` from the previews
Apps/ReachyStorybook/Generated/

# Coverage
*.profraw
*.profdata

# Local Claude Code state. `rules/` and `skills/` stay tracked — both carry
# instructions the repository owns rather than this machine.
.claude/*
!.claude/rules/
!.claude/skills/

# Environment
.envrc
mise.local.toml
.venv-sim/
.venv-sim-placo/
CLAUDE.local.md
# Left behind whenever a Scripts/*.py is imported as a module rather than run —
# which is how a new key gets spliced into the string catalogue through
# check-catalogue.py's own `emit`.
__pycache__/

# macOS
.DS_Store

# Brainstorming companion scratch
.superpowers/

# App Store Connect CLI run artifacts
.asc/

# Store screenshots. The artboards under `screenshots/artboards/*.html` are the
# design and stay tracked; everything around them is regenerable — the rendered
# PNGs live in App Store Connect, the simulator captures come from
# `screenshots:capture`, and the sticker copies are assembled by
# `screenshots:store` out of the catalogue.
screenshots/store/
screenshots/raw/
screenshots/artboards/stickers/
screenshots/artboards/capture-*.png
